# Copy to .env and fill in real values. Never commit the real file
# (.gitignore already excludes .env; only .env.example is tracked).

# LiteLLM proxy providing the v-flash virtual model (see CLAUDE.md).
LITELLM_BASE_URL=http://127.0.0.1:4000/v1
LITELLM_API_KEY=

# Optional overrides.
# S_AGENT_MODEL_NAME=v-flash
# S_AGENT_MODEL_MAX_TOKENS=2048
# S_AGENT_WORKSPACES_ROOT=/media/data/git/s_agent/workspaces
# S_AGENT_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
